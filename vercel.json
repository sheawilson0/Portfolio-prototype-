{
  "headers": [
    {
      "source": "/ar/assets/shea-wilson.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        }
      ]
    },
    {
      "source": "/links/shea-wilson.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Shea Wilson.vcf\""
        }
      ]
    },
    {
      "source": "/ar/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/link",
      "destination": "/links/",
      "permanent": true
    }
  ]
}
